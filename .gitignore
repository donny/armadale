# Generated by `xcodegen generate`, except the package lockfile the Xcode
# build resolves from (git cannot re-include a file inside an ignored
# directory, hence the step-by-step patterns).
/Armadale.xcodeproj/*
!/Armadale.xcodeproj/project.xcworkspace/
/Armadale.xcodeproj/project.xcworkspace/*
!/Armadale.xcodeproj/project.xcworkspace/xcshareddata/
/Armadale.xcodeproj/project.xcworkspace/xcshareddata/*
!/Armadale.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
/Armadale.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!/Armadale.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# Per-package lockfiles from `swift build` inside Packages/*; the app's
# lockfile above is the single source of truth for dependency versions.
Packages/*/Package.resolved

# Fetched zmx binaries (scripts/fetch-zmx.sh)
Vendor/zmx/

# The pinned dmgbuild environment for the release DMG (scripts/fetch-dmgbuild.sh)
Vendor/dmgbuild/

# SwiftPM / Xcode build products
.build/
DerivedData/
.swiftpm/
xcuserdata/
*.xcuserstate

# macOS
.DS_Store

# Release artifacts (scripts/release.sh)
/build/
